<section class="hero-section">
  <div class="container hero-shell">
    <div class="hero-copy">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p class="lede">{{ section.settings.subheading }}</p>
      <div class="cta-row">
        <a href="{{ routes.all_products_collection_url }}" class="primary-btn">{{ section.settings.primary_cta }}</a>
        <a href="/cart" class="secondary-btn">{{ section.settings.secondary_cta }}</a>
      </div>
      <div class="hero-badges">
        <span>Free shipping over $75</span>
        <span>Machine washable covers</span>
      </div>
    </div>

    <div class="hero-visual">
      <div class="hero-card">
        <img src="https://images.unsplash.com/photo-1583337130417-3346a1be7dee?auto=format&fit=crop&w=900&q=80" alt="Petora dog bed" />
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "class": "shopify-section-hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Petora" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Comfort-first beds for naps, play, and happy homes." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Soft, supportive designs made for cozy dogs and cats." },
    { "type": "text", "id": "primary_cta", "label": "Primary CTA", "default": "Shop beds" },
    { "type": "text", "id": "secondary_cta", "label": "Secondary CTA", "default": "View cart" }
  ]
}
{% endschema %}
